# Example environment variables for local development and Netlify
# IMPORTANT: Do NOT commit real secrets. Use Netlify UI (Site → Settings → Build & deploy → Environment) to set production values.

# API endpoint used by the frontend (example)
# NOTE: this project is currently front-end only (MVP). If you don't have a backend, leave commented or remove.
# VITE_API_URL=https://api.example.org

# Public storage/bucket base URL (if using presigned uploads)
VITE_STORAGE_BUCKET=https://storage.example.org/bucket-name

# Analytics / Monitoring (optional)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=

# Feature flags (optional)
VITE_FEATURE_FLAG_BETA=false

# The following are for CI/deploy automation (do NOT expose client secrets)
# NETLIFY_AUTH_TOKEN=your_netlify_token_if_using_cli_in_workflow